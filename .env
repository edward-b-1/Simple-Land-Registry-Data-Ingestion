# Default environment variables for docker-compose.
# This file is committed; override values via shell environment variables
# (which take precedence over this file) rather than editing it locally.

# database credentials (used by both the postgres and ingestion containers)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=postgres

# host used when connecting from outside docker (the ingestion container
# overrides this to the compose service name `postgres`)
POSTGRES_HOST=localhost

# host port the dockerized postgres is published on
POSTGRES_HOST_PORT=5432
