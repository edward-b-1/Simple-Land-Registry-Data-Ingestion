# Example environment variables for docker-compose.
# Copy this file to `.env` (which is gitignored) and fill in your own values:
#   cp .env.example .env
# Shell environment variables take precedence over values in `.env`.

# database credentials (used by both the postgres and ingestion containers).
# Note: POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DATABASE are only applied
# when the ./postgres_data directory is first created; to change them later,
# delete that directory and re-run `docker compose up -d postgres`.
POSTGRES_USER=land_registry
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=land_registry

# host used when connecting from outside docker (the ingestion container
# overrides this to the compose service name `postgres`)
POSTGRES_HOST=localhost

# host port the dockerized postgres is published on
POSTGRES_HOST_PORT=5432
